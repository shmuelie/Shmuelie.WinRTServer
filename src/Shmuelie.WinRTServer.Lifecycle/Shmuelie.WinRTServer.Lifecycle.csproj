<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <Description>Object-lifetime helpers for Shmuelie.WinRTServer: PollingServerLifetime and ReferenceCountedServerLifetime keep a server process alive until all created objects are released.</Description>
    <PackageReleaseNotes>External IServerLifetime helpers extracted into their own package.</PackageReleaseNotes>
    <IsAotCompatible>True</IsAotCompatible>
    <DisableRuntimeMarshalling>True</DisableRuntimeMarshalling>
    <RuntimeIdentifiers>win-x64;win-x86;win-arm64;$(RuntimeIdentifiers)</RuntimeIdentifiers>
    <AnalysisLevel>latest-all</AnalysisLevel>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Shmuelie.WinRTServer.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Shmuelie.WinRTServer.Core\Shmuelie.WinRTServer.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" PackagePath="\" Pack="true" Visible="false" />
    <None Include="..\..\LICENSE" PackagePath="\" Pack="true" Visible="false" />
  </ItemGroup>
</Project>
