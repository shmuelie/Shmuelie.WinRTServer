{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [
            "Shmuelie.WinRTServer/Shmuelie.WinRTServer.csproj",
            "Shmuelie.WinRTServer.Annotations/Shmuelie.WinRTServer.Annotations.csproj"
          ]
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net10.0-windows10.0.26100.0",
        "Platform": "x64"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**",
          "obj/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "Shmuelie.WinRTServer",
      "_appTitle": "Shmuelie.WinRTServer",
      "_enableSearch": true,
      "_appFooter": "Shmuelie.WinRTServer — Out-of-Process WinRT/COM Server",
      "_gitContribute": {
        "repo": "https://github.com/shmuelie/Shmuelie.WinRTServer",
        "branch": "main"
      }
    }
  }
}
