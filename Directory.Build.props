<Project>
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);MSB3270</NoWarn>
    <CsWinRTIIDOptimizerOptOut>true</CsWinRTIIDOptimizerOptOut>
  </PropertyGroup>

  <!-- Centralized location for all generated artifacts -->
  <PropertyGroup>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/</PackageOutputPath>
  </PropertyGroup>

  <!-- The next version used by local development and non-release CI builds. -->
  <PropertyGroup>
    <ShmuelieWinRTServerPackageVersion>2.2.1</ShmuelieWinRTServerPackageVersion>
    <_InputVersion>$(Version)</_InputVersion>
    <_InputVersionPrefix>$(VersionPrefix)</_InputVersionPrefix>
    <_InputVersionSuffix>$(VersionSuffix)</_InputVersionSuffix>
    <_IsGitHubBuild Condition="'$(GITHUB_RUN_ID)' != '' OR '$(GITHUB_ACTIONS)' == 'true'">true</_IsGitHubBuild>
    <_IsReleaseBuild Condition="'$(_IsGitHubBuild)' == 'true' AND '$(GITHUB_EVENT_NAME)' == 'push' AND '$(GITHUB_REF_TYPE)' == 'branch' AND $(GITHUB_REF_NAME.StartsWith('rel/'))">true</_IsReleaseBuild>
  </PropertyGroup>

  <!-- SemVer 2.0: numeric identifiers cannot have leading zeroes; metadata can. -->
  <PropertyGroup>
    <_PrereleaseIdentifier>(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)</_PrereleaseIdentifier>
    <_SemanticVersionRegex>\A((?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*))(?:-($(_PrereleaseIdentifier)(?:\.$(_PrereleaseIdentifier))*))?(?:\+([0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*))?\z</_SemanticVersionRegex>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_IsGitHubBuild)' != 'true'">
    <_LocalVersionPrefix>$(_InputVersionPrefix)</_LocalVersionPrefix>
    <_LocalVersionPrefix Condition="'$(_LocalVersionPrefix)' == ''">$(ShmuelieWinRTServerPackageVersion)</_LocalVersionPrefix>
    <_LocalVersionSuffix>$(_InputVersionSuffix)</_LocalVersionSuffix>
    <_LocalVersionSuffix Condition="'$(_LocalVersionSuffix)' == ''">alpha</_LocalVersionSuffix>
    <_ResolvedVersion>$(_LocalVersionPrefix)-$(_LocalVersionSuffix)</_ResolvedVersion>
    <_ResolvedVersion Condition="'$(_InputVersion)' != ''">$(_InputVersion)</_ResolvedVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_IsGitHubBuild)' == 'true'">
    <_CIVersionSuffix>alpha</_CIVersionSuffix>
    <_CIVersionSuffix Condition="'$(GITHUB_EVENT_NAME)' == 'pull_request'">pr</_CIVersionSuffix>
    <_ResolvedVersion>$(ShmuelieWinRTServerPackageVersion)-$(_CIVersionSuffix).$(GITHUB_RUN_ID)</_ResolvedVersion>
    <_ResolvedVersion Condition="'$(_IsReleaseBuild)' == 'true'">$(GITHUB_REF_NAME.Substring(4))</_ResolvedVersion>
    <_MetadataSeparator>+</_MetadataSeparator>
    <_MetadataSeparator Condition="$(_ResolvedVersion.Contains('+'))">.</_MetadataSeparator>
    <_ResolvedVersion Condition="'$(GITHUB_SHA)' != ''">$(_ResolvedVersion)$(_MetadataSeparator)$(GITHUB_SHA)</_ResolvedVersion>
  </PropertyGroup>

  <!-- Resolve before the SDK consumes Version; validate all public outputs in the targets file. -->
  <PropertyGroup>
    <_ResolvedVersionPrefix>$([System.Text.RegularExpressions.Regex]::Match('$(_ResolvedVersion)', '$(_SemanticVersionRegex)').Groups[1].Value)</_ResolvedVersionPrefix>
    <_ResolvedVersionSuffix>$([System.Text.RegularExpressions.Regex]::Match('$(_ResolvedVersion)', '$(_SemanticVersionRegex)').Groups[2].Value)</_ResolvedVersionSuffix>
    <VersionPrefix>$(_ResolvedVersionPrefix)</VersionPrefix>
    <VersionSuffix>$(_ResolvedVersionSuffix)</VersionSuffix>
    <Version>$(_ResolvedVersion)</Version>
    <PackageVersion>$(_ResolvedVersion)</PackageVersion>
    <AssemblyVersion>$(_ResolvedVersionPrefix).0</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <InformationalVersion>$(_ResolvedVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion Condition="'$(_IsGitHubBuild)' == 'true' AND '$(GITHUB_SHA)' != ''">false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <PropertyGroup>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_RUN_ID)' != ''">true</ContinuousIntegrationBuild>
    <RepositoryUrl>https://github.com/shmuelie/Shmuelie.WinRTServer/</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <ProjectUrl>https://github.com/shmuelie/Shmuelie.WinRTServer/</ProjectUrl>
    <Authors>Shmueli Englard</Authors>
    <Owners>Shmueli Englard</Owners>
    <Company>Shmueli Englard</Company>
    <Copyright>Copyright (c) 2025 Shmueli Englard</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageIcon>$(MSBuildProjectName)-128.png</PackageIcon>
    <PackageIconUrl>https://github.com/shmuelie/Shmuelie.WinRTServer/blob/main/Shmuelie.WinRTServer-64.png?raw=true</PackageIconUrl>
    <PackageTags>dotnet net netcore netstandard csharp library windows com winrt oop outofprocess rpc</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Out-of-Process WinRT/COM Server</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotNet.ReproducibleBuilds" Version="1.2.4" PrivateAssets="all" />
  </ItemGroup>

  <!-- Needed for deterministic builds -->
  <ItemGroup>
    <SourceRoot Include="$(MSBuildThisFileDirectory)/"/>
  </ItemGroup>
</Project>